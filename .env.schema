# Environment Schema for Lpturbo Deployment
# This file defines the required environment variables for the project

# Blockchain Configuration
PRIVATE_KEY=your_private_key_here
FUNDING_WALLET=0x1234567890123456789012345678901234567890
CONTRACT_ADDRESS=

# Network Configuration
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Deployment Configuration
ETH_AMOUNT=10
TOKEN_AMOUNT=500000

# Optional: Custom Router Address
ROUTER_ADDRESS=0x327Df1E6de05895d2ab08513aaDD9313Fe505d86