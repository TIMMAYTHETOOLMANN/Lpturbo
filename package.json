{
  "name": "lpturbo",
  "version": "1.0.0",
  "description": "Sovereign Liquidity Flash Engine",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.js --network base",
    "auto-reclaim": "node scripts/autoReclaim.js",
    "liquidity-assault": "node scripts/liquidityEngine.js",
    "inject": "node scripts/liquidityEngine.js",
    "test": "npx hardhat test",
    "monolith": "node lpturbo-monolith.js",
    "integration-test": "node test/integration.test.js",
    "optimize": "npm run monolith && npm run integration-test",
    "start": "python3 main.py init",
    "status": "python3 main.py status",
    "cli": "node cli/index.js",
    "api": "node -e \"const {LPTurboAPI} = require('./api'); new LPTurboAPI(3000).start()\"",
    "main": "python3 main.py",
    "health": "python3 main.py health",
    "security": "python3 main.py security --check",
    "config": "python3 main.py config --show",
    "emergency": "python3 main.py emergency-stop",
    "interactive": "node cli/index.js interactive"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.2",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "@openzeppelin/contracts": "^4.9.5",
    "@raydium-io/raydium-sdk": "^1.3.1-beta.58",
    "@uniswap/v2-sdk": "^3.0.1",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/sdk-core": "^4.0.1",
    "dotenv": "^16.3.1",
    "ethers": "^5.7.2",
    "hardhat": "^2.22.2",
    "jsbi": "^3.2.5"
  }
}
