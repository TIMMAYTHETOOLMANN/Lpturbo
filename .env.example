# Private key for the deployer wallet (must have ETH for gas fees)
PRIVATE_KEY=your_private_key_here

# Funding wallet address (where LP tokens will be sent after reclaim)
# If not provided, will default to deployer address
FUNDING_WALLET=your_funding_wallet_address_here

# Contract address (set after deployment for autoReclaim script)
CONTRACT_ADDRESS=deployed_contract_address_here

# ETH amount to use for initial liquidity (default: 0.1 ETH)
ETH_AMOUNT=0.1